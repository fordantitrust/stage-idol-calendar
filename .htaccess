# Stage Idol Calendar - Apache Configuration

# Clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sitemap, robots & manifest
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^manifest\.json$ manifest.php [L]

    # Event path with subpage: /event/slug/credits → credits.php?event=slug
    RewriteRule ^event/([^/]+)/([^/]+)$ $2.php?event=$1 [L,QSA]

    # Event path main page: /event/slug → index.php?event=slug
    RewriteRule ^event/([^/]+)/?$ index.php?event=$1 [L,QSA]

    # Artist feed: /artist/{id}/feed → feed.php?artist_id={id}
    RewriteRule ^artist/([0-9]+)/feed/?$ feed.php?artist_id=$1 [L,QSA]

    # Artist profile: /artist/{id} → artist.php?id={id}
    RewriteRule ^artist/([0-9]+)/?$ artist.php?id=$1 [L,QSA]

    # Venue profile: /venue/{id} → venue.php?id={id}
    RewriteRule ^venue/([0-9]+)/?$ venue.php?id=$1 [L,QSA]

    # Favorites Connect (QR scanner): /connect → connect.php
    RewriteRule ^connect/?$ connect.php [L,QSA]

    # My Favorites list: /my-favorites/{slug} → my-favorites.php?slug={slug}
    RewriteRule ^my-favorites/([0-9a-f-]+)/?$ my-favorites.php?slug=$1 [L,QSA]

    # Personal ICS feed: /my/{slug}/feed → my-feed.php?slug={slug}
    RewriteRule ^my/([0-9a-f-]+)/feed/?$ my-feed.php?slug=$1 [L,QSA]

    # My Upcoming Programs: /my/{slug} → my.php?slug={slug}
    RewriteRule ^my/([0-9a-f-]+)/?$ my.php?slug=$1 [L,QSA]

    # Favorites API: /api/favorites → api/favorites.php
    RewriteRule ^api/favorites/?$ api/favorites.php [L,QSA]

    # Remove .php extension (public pages only, not admin)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/admin/
    RewriteRule ^([^/]+)$ $1.php [L,QSA]

    # api/ subdirectory (api/request)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/([^/]+)$ api/$1.php [L,QSA]
</IfModule>

# --- Security Configuration ---

# ป้องกันการเข้าถึงไฟล์ database
<FilesMatch "\.(db|sqlite|sqlite3)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block CLI-only scripts from web access (defense in depth — also guarded in PHP)
<Files "sync-sw-version.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# ป้องกันการเข้าถึงไฟล์ config ที่มี sensitive data
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ป้องกัน directory listing
Options -Indexes

# ป้องกันการเข้าถึงไฟล์ .md
<FilesMatch "\.(md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Security Headers (สำรองกรณี PHP ไม่ทำงาน)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # PWA: Service Worker must be served from root scope
    <Files "service-worker.js">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>

    # PWA: manifest.json should not be cached aggressively
    <Files "manifest.json">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>
