# Tools Directory — Deny ALL HTTP Access
# Migration and developer utilities here are CLI-only.
# They have no business being reachable over HTTP from any origin,
# including LAN — shared/cloud hosting "LAN" CIDRs often overlap
# the provider's internal network and may be reachable by neighbours.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and 2.4 with mod_access_compat
<IfModule mod_access_compat.c>
    Order deny,allow
    Deny from all
</IfModule>
