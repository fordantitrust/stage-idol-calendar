# Configuration Directory — Deny ALL HTTP Access
# All files under config/ are loaded internally by PHP via require_once;
# none should ever be reachable over HTTP regardless of extension.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 and 2.4 with mod_access_compat
<IfModule mod_access_compat.c>
    Order deny,allow
    Deny from all
</IfModule>
