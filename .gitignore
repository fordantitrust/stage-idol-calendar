data/audit.db
data/audit.db-wal
data/audit.db-shm
*.db
*.db-shm
*.db-wal
*.db-journal
# Note: data/calendar.db is currently tracked. *.db prevents future *.db files
# from being accidentally added; existing tracked files are unaffected until
# explicitly removed with `git rm --cached`.

# Root-level debug / test scripts (must never be committed — see SECURITY_AUDIT_2026 HIGH-1)
test-*.php
debug-*.php

# Cache
cache/
*.cache

# Environment variables (if you add support later)
.env
.env.local
.env.*.local

